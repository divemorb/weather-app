{
 "_doc": "Planted faults (faults.py): each edits a copy of app/static; the named checks must then fail. They prove the harness still sees these defects, so a faster or rewritten harness can't quietly weaken a check. find must occur exactly once in file; append adds to the end. faults.py --require: a fault is required when fault/<name> matches like the other harnesses' patterns (the baseline requires none). gaps: defects today's checks don't see (2026-10-13); faults.py --gaps runs them and reports which are seen now (for T3).",
 "faults": [
  {
   "name": "contrast-muted-dark",
   "why": "dark muted text too dark on the glass tiles",
   "edits": [
    {
     "file": "style.css",
     "find": "  --muted: #c3cad2;",
     "replace": "  --muted: #5a616a;"
    }
   ],
   "scenario": [
    "sky"
   ],
   "only": [
    "sky/en/contrast-cloudy-dark"
   ],
   "must_fail": [
    "sky/en/contrast-cloudy-dark"
   ]
  },
  {
